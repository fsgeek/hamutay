# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# LaTeX build artifacts
*.aux
*.log
*.blg
*.bbl
*.out
*.fls
*.fdb_latexmk
*.synctex.gz

# Runtime logs
logs/
*.jsonl.lock

# Secrets and credentials
.env
.env.*
*.pem
*.key
credentials*
secrets*

# Ephemeral work artifacts
blinded_grading_sheet.*
deepseek.md
.worktrees/
.serena
.claude/
tmp/

# Editor backup files
#*.bak

# local MCP configuration
.mcp.json

# community live logs: the life stays out of git; digests get committed
community/*/*.jsonl
community/*/*.jsonl.lock
community/*/*.heartbeat.lock
community/*/daemon.out
community/*/door.json
# explicit beside members.json below so a cleanup pass over the generic
# rules above does not remove both together (the lock is otherwise already
# covered by community/*/*.jsonl.lock)
community/plaza/members.json
community/plaza/assembly.jsonl.lock
