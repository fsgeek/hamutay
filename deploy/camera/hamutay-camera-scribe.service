# The camera's scribe (spec: docs/superpowers/specs/2026-11-03-access-camera-design.md).
# A user unit of the house user; installed to ~/.config/systemd/user by deploy/camera/install.sh.
[Unit]
Description=hamutay camera scribe: coalesces the gate's records into ArangoDB (ayllu_camera)

[Service]
Type=simple
WorkingDirectory=/home/tony/projects/hamutay
ExecStart=/home/tony/.local/bin/uv run python -m hamutay.camera_scribe
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
