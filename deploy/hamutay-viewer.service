[Unit]
Description=Hamutay ayllu viewer — read-only local page of the plaza, assembly and door vitals (127.0.0.1:8787)

[Service]
WorkingDirectory=%h/projects/hamutay
ExecStart=%h/.local/bin/uv run python -m hamutay.viewer --project-root %h/projects/hamutay --port 8787
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
